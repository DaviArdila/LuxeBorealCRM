{
  "name": "cliente",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "test:herramientas": "vitest run --config vitest.herramientas.config.ts",
    "api:generar": "node herramientas/api.mjs generar",
    "api:deriva": "node herramientas/api.mjs deriva",
    "ci": "npm run lint && npm test && npm run test:herramientas && npm run build && npm run api:deriva"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "material-symbols": "^0.47.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
