# Chatwoot local. `scripts/chatwoot-up.sh` genera infra/chatwoot/.env con secretos aleatorios a
# partir de este archivo. Nunca commitear el .env real.

SECRET_KEY_BASE=replace_with_lengthy_secure_hex
# URL con la que el navegador llega a Chatwoot (puerto 3001 en el host, ver docker-compose.yml).
FRONTEND_URL=http://localhost:3001
FORCE_SSL=false
# Registro abierto solo para crear la primera cuenta; después conviene ponerlo en false.
ENABLE_ACCOUNT_SIGNUP=true

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_me

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DATABASE=chatwoot
# Rol y bases de LuxeBorealCRM en este mismo Postgres (ver comentario en docker-compose.yml sobre la
# topología de producción de CLAUDE.md §Stack); lo crea init/01-luxeboreal.sh
LUXEBOREAL_DB_PASSWORD=replace_me

RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# Sin SMTP en local: Chatwoot arranca igual, solo no manda correos (invitaciones, recuperación).
MAILER_SENDER_EMAIL=Chatwoot <chatwoot@localhost>
SMTP_ADDRESS=
SMTP_PORT=1025

# Para el inbox de WhatsApp Cloud (fases futuras): App Secret de la app de Meta, para que Chatwoot
# valide la firma X-Hub-Signature-256 de los webhooks de Meta. Vacío mientras no haya credenciales.
WHATSAPP_APP_SECRET=

# SOLO LOCAL: permite que el Agent Bot llame a URLs privadas (host.docker.internal). Chatwoot
# bloquea webhooks a IPs privadas por defecto (protección SSRF). En el VPS NO va esta variable:
# el bot tiene dominio público.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
