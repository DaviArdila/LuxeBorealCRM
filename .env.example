# Configuración de la aplicación. Copia este archivo a .env para desarrollo local.
# No subas .env ni reutilices las credenciales de ejemplo en producción.

# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Puerto HTTP (1-65535).
PORT=3000

# Nivel de logs: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# URLs requeridas. Estas credenciales son solo para desarrollo local.
DATABASE_URL=postgresql://luxe:luxe@localhost:5435/luxeboreal
REDIS_URL=redis://localhost:6380

# Tiempo máximo en milisegundos para cada comprobación de salud (100-10000).
HEALTH_TIMEOUT_MS=1500

# Habilita /docs (Scalar) sobre el documento OpenAPI público. Default false; MUST NOT ser
# true cuando NODE_ENV=production (D7, API9 — validado en tiempo de carga).
DOCS_HABILITADO=false

# Almacenamiento de objetos (MinIO) para fotos de producto y collages (Fase 03, ADR-0012).
MINIO_ENDPOINT=localhost
MINIO_PUERTO=9000

# 'true' o 'false' de texto, igual que DOCS_HABILITADO.
MINIO_SSL=false

MINIO_ACCESS_KEY=luxe
MINIO_SECRET_KEY=luxeclave
MINIO_BUCKET=luxeboreal-medios

# Opcional. Si no se define, AlmacenamientoMinio arma la URL pública con endpoint + puerto + SSL.
# Un valor vacío NO es válido (debe ser una URL): déjala comentada salvo que la necesites.
# MINIO_URL_PUBLICA=https://medios.ejemplo.com

# Valor por defecto de --sheet-id; el CLI de importación (catalogo:importar) también lo acepta como flag.
CATALOGO_SHEET_ID=

# Canal Chatwoot (Fase 04, ADR-0004/ADR-0005): API de salida y verificación de firma del webhook.
CHATWOOT_URL=http://localhost:3001
CHATWOOT_ACCOUNT_ID=1
# URL por la que el asesor abre Chatwoot desde su celular (enlaces de los avisos de Telegram). Si falta, se
# usa CHATWOOT_URL, que en local es localhost y el celular no abre.
# CHATWOOT_URL_PUBLICA=https://chat.ejemplo.co

# Token del Agent Bot y secreto del webhook: genéralos con scripts/chatwoot-up.sh +
# scripts/chatwoot-bootstrap.sh (infra local en infra/chatwoot/); nunca compartas los valores reales.
CHATWOOT_BOT_TOKEN=
# Token de LECTURA de mensajes: Chatwoot responde 401 a un token de Agent Bot al listar mensajes.
# Sácalo de Chatwoot → Profile Settings → Access Token de un usuario agente; nunca lo commitees.
# Solo lee (el bot sigue escribiendo con CHATWOOT_BOT_TOKEN). Vacío cae al del bot, con un aviso.
CHATWOOT_API_TOKEN_LECTURA=
CHATWOOT_WEBHOOK_SECRETO=

# Tolerancia anti-replay de la firma del webhook, en segundos.
CHATWOOT_WEBHOOK_TOLERANCIA_S=300

# Timeout del cliente HTTP hacia la API de Chatwoot, en milisegundos.
CHATWOOT_HTTP_TIMEOUT_MS=10000

# plataforma/colas (Fase 04, D6): raíz de BullMQ sobre el mismo REDIS_URL.
COLAS_PREFIJO=luxe:colas

# Si este proceso arranca los workers de BullMQ. 'false' en los contextos que generan el
# contrato OpenAPI, sin Redis real (D6).
COLAS_TRABAJADORES=true

# Procesador del inbox (D7): intentos de BullMQ antes de marcar error en la fila, y cada cuántos
# milisegundos se reencolan filas pendientes sin error.
INBOX_MAX_INTENTOS=5
INBOX_BARRIDO_MS=30000

# plataforma/outbox (Fase 04, T6, D10/D12): outbox genérico de efectos externos.
# Intentos antes de agotar y marcar error; backoff exponencial min(base*2^(n-1), max) en segundos;
# cada cuántos milisegundos el barrido reintenta disparos perdidos; duración del lease (segundos)
# de una fila reclamada antes de volver a estar disponible.
OUTBOX_MAX_INTENTOS=5
OUTBOX_BACKOFF_BASE_S=15
OUTBOX_BACKOFF_MAX_S=300
OUTBOX_BARRIDO_MS=5000
OUTBOX_LEASE_S=60

# modulos/conversaciones (Fase 05): vencimientos, lock del turno, rate limit y debounce.
# Horas que `humano` espera actividad del asesor antes de volver a `bot` (mínimo 0.5).
HUMANO_TTL_HORAS=3

# Minutos que `handoff_pendiente` espera a que alguien lo recoja, y minutos antes del aviso único de espera.
HANDOFF_TTL_MIN=45
HANDOFF_ESPERA_MIN=30
# Minutos que un cliente espera bajo control humano antes de avisar al asesor (>= 1).
ESPERA_CLIENTE_MIN=10
# Cada cuánto se revisan los clientes que esperan respuesta, en milisegundos (>= 10000).
ESPERA_CLIENTE_BARRIDO_MS=60000

# TTL en segundos del lock por conversación (mínimo 5). El timeout del LLM debe quedar por debajo.
LOCK_TURNO_TTL_S=30

# Tope de mensajes por contacto en la hora y en el día en curso (R13).
RATE_LIMIT_POR_HORA=20
RATE_LIMIT_POR_DIA=60

# Ventana en milisegundos que agrupa una ráfaga de mensajes del cliente en un solo turno.
DEBOUNCE_MS=3000

# Conversaciones procesadas en paralelo y cada cuántos milisegundos se devuelven a `bot` las vencidas.
CONVERSACIONES_CONCURRENCIA=10
CONVERSACIONES_BARRIDO_MS=300000

# --- LLM (Fase 06): perfiles, reintento, circuit breaker, techo y OpenRouter ---
LLM_CONVERSACION_MODELOS=openai/gpt-6-luna        # CSV en orden de prioridad (fallback)
LLM_CONVERSACION_TIMEOUT_MS=15000                 # debe ser < LOCK_TURNO_TTL_S * 1000
LLM_CONVERSACION_MAX_TOKENS=400
LLM_CONVERSACION_MAX_REINTENTOS=2                 # 0-2
LLM_EVALS_MODELOS=openai/gpt-6-luna
LLM_EVALS_TIMEOUT_MS=30000
LLM_EVALS_MAX_TOKENS=400
LLM_EVALS_MAX_REINTENTOS=2
# Techo mensual de gasto del LLM en USD (R13). Es el valor por defecto: se puede subir o bajar sin
# reiniciar guardando un número en la clave `llm_techo_mensual_usd` de la tabla `parametro`.
LLM_TECHO_MENSUAL_USD=10
# Porcentaje del techo al que se emite el aviso `warn` (una vez por mes).
LLM_UMBRAL_AVISO_PCT=80
# Precios en USD por millón de tokens, por modelo; deben cubrir todos los modelos de ambos perfiles.
# Verificados el 2026-09-30 contra https://openrouter.ai/api/v1/models (campo pricing x 1.000.000).
# Repetir la verificación antes de producción y cada vez que cambie un modelo.
LLM_PRECIOS_USD_JSON={"openai/gpt-6-luna":{"entrada":0.1,"salida":0.5,"cache":0.01}}
LLM_REINTENTO_BASE_MS=500
LLM_REINTENTO_MAX_MS=2000
LLM_CB_UMBRAL_FALLOS=5
LLM_CB_VENTANA_S=60
OPENROUTER_API_KEY=                               # obligatoria en production si algún modelo va a OpenRouter; nunca commitear
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Proveedor directo (ADR-0019). Un id sin prefijo va a OpenRouter; `openai:<modelo>` va directo a
# OpenAI con el id que sigue al prefijo. Solo se exige en production si algún perfil usa `openai:`.
OPENAI_API_KEY=                                   # nunca commitear
# Para usar OpenAI directo: 1) pon tu clave en OPENAI_API_KEY, 2) descomenta las dos líneas siguientes,
# 3) reemplaza los precios por los de https://openai.com/api/pricing (USD por millón de tokens; no se
# inventan aquí). La clave de precio es el id completo con prefijo. El modelo sin prefijo queda como
# respaldo por OpenRouter. LLM_EVALS_MODELOS acepta los mismos ids; la corrida real de evals
# (EVALS_MODO=real) exige la clave de cada proveedor que use.
# LLM_CONVERSACION_MODELOS=openai:gpt-6-luna,openai/gpt-6-luna
# LLM_PRECIOS_USD_JSON={"openai:gpt-6-luna":{"entrada":0,"salida":0,"cache":0},"openai/gpt-6-luna":{"entrada":0.1,"salida":0.5,"cache":0.01}}

# modulos/agente (Fase 07a, D10)
# Turnos que el bot responde por sesión antes de derivar a un asesor (R13). Entero >= 1.
AGENTE_TOPE_TURNOS=12
# Vida en horas de los contadores de sesión del agente en Redis. Entero 1-720.
AGENTE_SESION_TTL_H=168
# Fase 07b (D10): vueltas máximas del bucle de herramientas por turno (1-8).
AGENTE_MAX_VUELTAS=5
# Turnos previos de la sesión que se envían al LLM (0-20; 0 = sin historial).
AGENTE_HISTORIAL_TURNOS=6
# Fotos que el bot puede enviar por sesión (1-10).
AGENTE_FOTOS_INDIVIDUALES_MAX=4
# El importador de catálogo genera el collage de cada producto solo si es true (por defecto false;
# el bot envía una foto por defecto y otras bajo demanda).
CATALOGO_GENERAR_COLLAGE=false

# Avisos a los asesores por Telegram (Fase 08, D9/D11). Crea un bot con @BotFather y un grupo; el
# token y el chat id son obligatorios en production. Nunca commitear los valores reales.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
# Timeout del cliente HTTP hacia Telegram, en milisegundos.
TELEGRAM_HTTP_TIMEOUT_MS=5000
# Un solo aviso de lead por contacto en esta ventana, en horas (1-168).
LEADS_VENTANA_NOTIFICACION_H=24
# Minutos que un lead derivado espera sin atenderse antes de recordarlo al asesor (1-1440).
LEADS_RECORDATORIO_MIN=30
# Cada cuánto se revisan los leads sin atender, en milisegundos (>= 1000).
LEADS_BARRIDO_MS=60000
