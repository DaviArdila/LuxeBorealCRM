# Configuración de la aplicación. Copia este archivo a .env para desarrollo local.
# No subas .env ni reutilices las credenciales de ejemplo en producción.

# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Puerto HTTP (1-65535).
PORT=3000

# Nivel de logs: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# URLs requeridas. Estas credenciales son solo para desarrollo local.
DATABASE_URL=postgresql://luxe:luxe@localhost:5435/luxeboreal
REDIS_URL=redis://localhost:6380

# Tiempo máximo en milisegundos para cada comprobación de salud (100-10000).
HEALTH_TIMEOUT_MS=1500

# Habilita /docs (Scalar) sobre el documento OpenAPI público. Default false; MUST NOT ser
# true cuando NODE_ENV=production (D7, API9 — validado en tiempo de carga).
DOCS_HABILITADO=false

# Almacenamiento de objetos (MinIO) para fotos de producto y collages (Fase 03, ADR-0012).
MINIO_ENDPOINT=localhost
MINIO_PUERTO=9000

# 'true' o 'false' de texto, igual que DOCS_HABILITADO.
MINIO_SSL=false

MINIO_ACCESS_KEY=luxe
MINIO_SECRET_KEY=luxeclave
MINIO_BUCKET=luxeboreal-medios

# Si se deja vacío, AlmacenamientoMinio arma la URL pública con endpoint + puerto + SSL.
MINIO_URL_PUBLICA=

# Valor por defecto de --sheet-id; el CLI de importación (catalogo:importar) también lo acepta como flag.
CATALOGO_SHEET_ID=

# Canal Chatwoot (Fase 04, ADR-0004/ADR-0005): API de salida y verificación de firma del webhook.
CHATWOOT_URL=http://localhost:3001
CHATWOOT_ACCOUNT_ID=1

# Token del Agent Bot y secreto del webhook: genéralos con scripts/chatwoot-bootstrap.sh del
# prototipo (o su equivalente ya portado a este repo); nunca compartas los valores reales.
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRETO=

# Tolerancia anti-replay de la firma del webhook, en segundos.
CHATWOOT_WEBHOOK_TOLERANCIA_S=300

# Timeout del cliente HTTP hacia la API de Chatwoot, en milisegundos.
CHATWOOT_HTTP_TIMEOUT_MS=10000

